{
  "description": "GameFrame's gates: no game material or decompiled code in commits or tracked files, only re-lander commits and pushes, no deleting a project's game folder (game/), a short status at the start of a session, and known failure modes after a shell command (docs/working/knowhow.md). See docs/working/gates.md.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/gate.py", "session"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git commit *)", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/gate.py", "commit"], "timeout": 30 },
          { "type": "command", "if": "Bash(git push *)", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/gate.py", "push"], "timeout": 10 },
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/gate.py", "delete"], "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/gate.py", "write"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/advise.py", "post"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/advise.py", "post"], "timeout": 10 }
        ]
      }
    ]
  }
}
