{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 scripts/hooks/gate.py cursor",
        "matcher": "git|rm|mv|find|cargo|trash|unlink|kondo|npkill|clean|rmtree|Trash",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": "python3 scripts/hooks/advise.py cursor",
        "matcher": "Shell",
        "timeout": 10
      }
    ]
  }
}
