{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/gate.py\" codex",
            "timeout": 30,
            "statusMessage": "GameFrame gates"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/advise.py\" codex",
            "timeout": 10,
            "statusMessage": "GameFrame know-how"
          }
        ]
      }
    ]
  }
}
